rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gmurugesh71@gmail.com' ||
        request.auth.token.email == 'admin@aiexplorer.edu' ||
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin Audit Logs: restricted to Admins
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Students Directory
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentId.size() > 0
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0;
      allow update: if isAdmin() || (request.resource.data.studentId == studentId);
      allow delete: if isAdmin();
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentId.size() > 0
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 15;
      allow update, delete: if isAdmin();
    }

    // Student Progress
    match /studentProgress/{progressId} {
      allow read: if true;
      allow create, update: if request.resource.data.studentId is string;
      allow delete: if isAdmin();
    }

    // Prompt Gym Submissions
    match /promptSubmissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.promptText is string;
      allow update, delete: if isAdmin();
    }

    // Career Assessments
    match /careerAssessments/{assessmentId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentName is string;
      allow update, delete: if isAdmin();
    }

    // Student Badges & Achievements
    match /studentBadges/{badgeId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.badgeName is string;
      allow update, delete: if isAdmin();
    }

    // Legacy Submissions / Results Collection
    match /results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.studentName is string;
      allow update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
