rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isSignedIn() && (
        request.auth.token.email == 'gmurugesh71@gmail.com' ||
        request.auth.token.email == 'vaanadhikaarthihaa71@gmail.com' ||
        request.auth.token.email == 'admin@aiexplorer.edu' ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email.matches('.*organizer.*') ||
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ));
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || true;
    }

    // Students Directory
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Student Progress
    match /studentProgress/{progressId} {
      allow read, write: if true;
    }

    // Prompt Gym Submissions
    match /promptSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Career Assessments
    match /careerAssessments/{assessmentId} {
      allow read, write: if true;
    }

    // Student Badges & Achievements
    match /studentBadges/{badgeId} {
      allow read, write: if true;
    }

    // Engagement & Performance Metrics (Across Workshop Sections)
    match /engagementMetrics/{metricId} {
      allow read, write: if true;
    }

    // Section Rollup Metrics
    match /sectionMetrics/{metricId} {
      allow read, write: if true;
    }

    // Legacy Submissions / Results Collection
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
